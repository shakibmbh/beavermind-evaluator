# Supabase (find these in Project Settings -> API in your Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, never expose to the browser

# Gemini API key -- free tier, get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Inngest -- if you installed via the Vercel Marketplace integration, these
# are set automatically and you don't need to add them here. Only needed
# for local `npx inngest-cli dev` against a deployed app, or manual setup.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
